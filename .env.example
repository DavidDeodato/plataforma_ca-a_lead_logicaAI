firecrawl_api=your-firecrawl-api-key
openai_api_key=your-openai-api-key
database_url=postgresql://user:password@host:5432/database?sslmode=require

wasender_api_key=your-session-api-key
wasender_personal_access_token=your-personal-access-token
wasender_webhook_secret=your-webhook-secret
wasender_api_base_url=https://www.wasenderapi.com
app_url=http://localhost:8000

default_niche=barbearia
default_city=Vitoria, ES
openai_model=gpt-4.1-mini
firecrawl_agent_model=spark-1-mini
firecrawl_agent_max_credits=1500
outreach_daily_limit=20
outreach_delay_seconds=300
outbound_enabled=true
auto_reply_enabled=false
